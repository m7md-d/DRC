{
  "name": "drc",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --bundles app",
    "rust:test": "node scripts/rust.mjs test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "node scripts/rust.mjs clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "desktop:build:linux": "node scripts/desktop.mjs build --config src-tauri/tauri.linux.conf.json --bundles deb"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
