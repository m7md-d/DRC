+// DRC modification (18 October 2026): preserve an inherited O_RDONLY
+// input capability on macOS. Opening /dev/fd/N rechecks device permissions;
+// dup uses the already-authorized descriptor without reopening the device.
+int drc_open_readonly_input( const char * const name, const int flags )
+  {
+  const char prefix[] = "/dev/fd/";
+  if( std::strncmp( name, prefix, sizeof prefix - 1 ) != 0 )
+    return open( name, flags );
+  const char * const number = name + sizeof prefix - 1;
+  if( !*number ) { errno = EINVAL; return -1; }
+  int fd = 0;
+  for( const char * p = number; *p; ++p )
+    {
+    if( *p < '0' || *p > '9' || fd > ( INT_MAX - ( *p - '0' ) ) / 10 )
+      { errno = EINVAL; return -1; }
+    fd = fd * 10 + ( *p - '0' );
+    }
+  if( flags != ( O_RDONLY | O_BINARY ) )
+    { errno = ENOTSUP; return -1; }
+  const int inherited_flags = fcntl( fd, F_GETFL );
+  if( inherited_flags < 0 ) return -1;
+  if( ( inherited_flags & O_ACCMODE ) == O_RDONLY ) return dup( fd );
+  // Access modes cannot be changed with F_SETFL. Reopen read-only, bind it
+  // to the inherited object's identity, and drop the writable capability.
+  struct stat before, after;
+  if( fstat( fd, &before ) != 0 ) return -1;
+#ifdef __APPLE__
+  char source_path[PATH_MAX];
+  if( fcntl( fd, F_GETPATH, source_path ) < 0 ) return -1;
+  const int readonly = open( source_path, O_RDONLY | O_NOFOLLOW | O_BINARY );
+#else
+  const int readonly = open( name, O_RDONLY | O_BINARY );
+#endif
+  if( readonly < 0 ) return -1;
+  const int readonly_flags = fcntl( readonly, F_GETFL );
+  if( fstat( readonly, &after ) != 0 || readonly_flags < 0 )
+    { const int saved_errno = errno; close( readonly ); errno = saved_errno; return -1; }
+  if( before.st_dev != after.st_dev || before.st_ino != after.st_ino ||
+      before.st_rdev != after.st_rdev ||
+      ( before.st_mode & S_IFMT ) != ( after.st_mode & S_IFMT ) ||
+      ( readonly_flags & O_ACCMODE ) != O_RDONLY )
+    { close( readonly ); errno = ESTALE; return -1; }
+  close( fd );
+  return readonly;
+  }
 
 
